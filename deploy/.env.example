# The token from the Cloudflare dashboard: Zero Trust -> Networks -> Tunnels
# -> Create a tunnel -> Cloudflared. Copy the value after `--token` from the
# install command it shows you. Treat it as a password.
TUNNEL_TOKEN=

# Which published release to serve. Must be a tag that has a
# OpenWord-<tag>-web.zip asset.
OPENWORD_VERSION=v1.10.0
