# OpenWord deployment settings. Copy to .env (install.sh does this and fills
# in the generated parts). Treat this file as a password store: it is
# git-ignored and nothing but docker compose and the `openword` helper read
# it. Values are unquoted; keep them to letters, digits and URL characters.

# --- Cloudflare Tunnel (public HTTPS, no port forwarding) -------------------
# Cloudflare dashboard -> Zero Trust -> Networks -> Tunnels -> Create a
# tunnel -> Cloudflared, then copy the long value after `--token` from the
# install command it shows. Leave empty for a LAN-only install.
TUNNEL_TOKEN=

# The address people type: the public hostname you gave the tunnel, e.g.
# https://bible.example.org (no trailing slash). The API puts it in push
# notifications. For a LAN install, http://<pi's address>:<OPENWORD_PORT>.
OPENWORD_PUBLIC_URL=

# --- LAN-only install (used only without a tunnel token) --------------------
# The port on the Pi that serves the app when there is no tunnel.
OPENWORD_PORT=8080

# --- Accounts ---------------------------------------------------------------
# Set this and registration asks for it; leave it empty and anyone who can
# reach the site may make an account.
OPENWORD_INVITE_CODE=

# Optional. Push services may contact this address about your subscriptions
# (it becomes the VAPID "subject"). Not shown to users.
OPENWORD_ADMIN_EMAIL=

# --- Database ---------------------------------------------------------------
# Generated by install.sh (openssl rand -hex 24). Letters and digits only:
# it goes into a connection URL unescaped. Changing it after the first start
# does not change the password Postgres already stored.
POSTGRES_PASSWORD=

# --- Images -----------------------------------------------------------------
# Tag for the images: with OPENWORD_PREBUILT=1 it picks the release to pull
# from ghcr.io (a tag such as v2.0.0, or latest); otherwise it only names the
# images built here.
OPENWORD_VERSION=latest

# 1 pulls the images GitHub Actions built (docker-compose.prebuilt.yml)
# instead of building on this machine. Empty builds from the checkout.
OPENWORD_PREBUILT=

# debug, info, warn or error.
OPENWORD_LOG_LEVEL=info
