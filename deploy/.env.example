# Which cloudflared runs: `tunnel` for your own domain (needs TUNNEL_TOKEN),
# or `quick` for a random https://<words>.trycloudflare.com address that needs
# no Cloudflare account and changes whenever the container restarts.
COMPOSE_PROFILES=tunnel

# The token from the Cloudflare dashboard: Zero Trust -> Networks -> Tunnels
# -> Create a tunnel -> Cloudflared. Copy the value after `--token` from the
# install command it shows you. Treat it as a password. Point the tunnel's
# public hostname at http://web:80.
TUNNEL_TOKEN=

# Which published release to serve. Must be a tag that has a
# OpenWord-<tag>-web.zip asset. The installer sets it to the latest one.
OPENWORD_VERSION=v1.30.0
