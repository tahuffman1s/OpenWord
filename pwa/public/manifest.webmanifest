{
  "name": "OpenWord",
  "short_name": "OpenWord",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "background_color": "#fef7ff",
  "theme_color": "#fef7ff",
  "description": "A free and open source Bible reader, with the Hebrew and Greek behind every verse, a voice that reads aloud, reading plans and verses learnt by heart.",
  "orientation": "any",
  "lang": "en",
  "categories": [
    "books",
    "education",
    "lifestyle"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icons/Icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icons/Icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icons/Icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/Icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Today's lesson",
      "url": "/?open=learn",
      "icons": [
        {
          "src": "/icons/Icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Continue listening",
      "url": "/?open=listen",
      "icons": [
        {
          "src": "/icons/Icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Reading plans",
      "url": "/?open=plans",
      "icons": [
        {
          "src": "/icons/Icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
